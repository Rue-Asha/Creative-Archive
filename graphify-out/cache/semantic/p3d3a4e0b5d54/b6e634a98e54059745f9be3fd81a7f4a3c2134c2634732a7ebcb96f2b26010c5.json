{"nodes": [{"id": "claude_creative_archive", "label": "Creative Archive (agent instructions)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_kit_config_in_vite", "label": "Kit config in vite.config.ts and #lib imports", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L4-L5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SvelteKit 3 refuses svelte.config.js and drops $lib, so config lives in sveltekit({...}) inside vite.config.ts and imports go through package.json imports (#lib/...) with explicit .ts extension."}, {"id": "claude_proof_harness", "label": "Proof harness (proof / proof:full)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L7-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "proof = svelte-check --fail-on-warnings, build, vitest; build precedes tests because scripts/server.test.ts spawns the built server. proof:full adds Playwright."}, {"id": "claude_playwright_e2e_setup", "label": "Playwright e2e setup (phone/desktop projects)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L15-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Projects phone 390x844 touch and desktop 1280x800, workers 1, against node build on $PORT with a throwaway DATABASE_PATH=.e2e/$PORT.db so parallel runs on different ports don't interfere; E2E_APP_DIR serves the unpacked CI tarball instead. Tests reset+seed data and wait for html[data-hydrated]."}, {"id": "claude_test_mode_routes", "label": "CREATIVE_ARCHIVE_TEST /__test/* routes and fakes", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L17-L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_proxy_csrf_requirement", "label": "Proxy protocol header for Kit CSRF", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L21-L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without PROTOCOL_HEADER or ORIGIN, Kit's CSRF check rejects form posts and DELETEs over plain http behind the proxy; e2e sends x-forwarded-proto: http, and BODY_SIZE_LIMIT=17M lets 16 MB photo uploads through."}, {"id": "claude_calm_reduced_motion", "label": "calm(page) reduced-motion test helper", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests that don't exercise motion force reduced motion so transitions can't make them flaky."}, {"id": "claude_package_tarball", "label": "npm run package release tarball", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_openspec_specs", "label": "OpenSpec capability specs", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L28-L45", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec per capability (artist-link, autofill, collections, design-system, domain-lists, domain-pages, entries, harness, home, images, layout, link-preview, motion, release, settings, tags, tracking) must be read before changing that area."}, {"id": "claude_learning_outro_aria_hidden", "label": "Learning: aria-hidden on Svelte outrostart", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Svelte only sets inert during outro; a 160 ms outro left a duplicate Save button that broke strict-mode locators on phone."}, {"id": "claude_learning_save_helpers", "label": "Learning: countSaves / recordSaves e2e helpers", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L50", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detail controls queue optimistic POSTs, so a reload lost writes; recordSaves gives the exact list because a stray same-value save satisfied toBe(1)."}, {"id": "claude_learning_style_guards", "label": "Learning: no raw colours or clip-path transitions", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "motion.test.ts bans raw colours and clip-path transitions; static guards must be paired with computed-style e2e since a 13px select passed the static scan; failures use the error token."}, {"id": "claude_learning_navigationtype_import", "label": "Learning: NavigationType from $app/navigation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_creative_archive", "target": "claude_kit_config_in_vite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L4", "weight": 1.0}, {"source": "claude_creative_archive", "target": "claude_proof_harness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L7", "weight": 1.0}, {"source": "claude_creative_archive", "target": "claude_openspec_specs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L28", "weight": 1.0}, {"source": "claude_proof_harness", "target": "claude_playwright_e2e_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "L15", "weight": 1.0}, {"source": "claude_playwright_e2e_setup", "targe